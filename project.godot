; Engine configuration file.
; Prefer editing this file through the Godot editor after the initial bootstrap.

config_version=5

[application]

config/name="Wanderlight: Moon Shard"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/systems/game_state.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[input]

move_forward={
"deadzone": 0.25,
"events": [Object(InputEventKey,"physical_keycode":87,"unicode":119), Object(InputEventKey,"physical_keycode":4194320)]
}
move_back={
"deadzone": 0.25,
"events": [Object(InputEventKey,"physical_keycode":83,"unicode":115), Object(InputEventKey,"physical_keycode":4194322)]
}
move_left={
"deadzone": 0.25,
"events": [Object(InputEventKey,"physical_keycode":65,"unicode":97), Object(InputEventKey,"physical_keycode":4194319)]
}
move_right={
"deadzone": 0.25,
"events": [Object(InputEventKey,"physical_keycode":68,"unicode":100), Object(InputEventKey,"physical_keycode":4194321)]
}
camera_rotate_left={
"deadzone": 0.25,
"events": [Object(InputEventKey,"physical_keycode":81,"unicode":113)]
}
camera_rotate_right={
"deadzone": 0.25,
"events": [Object(InputEventKey,"physical_keycode":69,"unicode":101)]
}
camera_zoom_in={
"deadzone": 0.25,
"events": [Object(InputEventKey,"physical_keycode":82,"unicode":114)]
}
camera_zoom_out={
"deadzone": 0.25,
"events": [Object(InputEventKey,"physical_keycode":70,"unicode":102)]
}
interact={
"deadzone": 0.25,
"events": [Object(InputEventKey,"physical_keycode":32,"unicode":32), Object(InputEventKey,"physical_keycode":4194309)]
}
save_game={
"deadzone": 0.25,
"events": [Object(InputEventKey,"physical_keycode":4194336)]
}
load_game={
"deadzone": 0.25,
"events": [Object(InputEventKey,"physical_keycode":4194340)]
}
battle_attack={
"deadzone": 0.25,
"events": [Object(InputEventKey,"physical_keycode":49,"unicode":49)]
}
battle_skill={
"deadzone": 0.25,
"events": [Object(InputEventKey,"physical_keycode":50,"unicode":50)]
}
battle_potion={
"deadzone": 0.25,
"events": [Object(InputEventKey,"physical_keycode":51,"unicode":51)]
}
battle_guard={
"deadzone": 0.25,
"events": [Object(InputEventKey,"physical_keycode":52,"unicode":52)]
}

[physics]

3d/default_gravity=18.0

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.035, 0.047, 0.075, 1)
